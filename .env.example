# ==============================================================================
# PrintStyle - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit your actual `.env.local` with real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Database Configuration (Free Tier M0)
# ------------------------------------------------------------------------------
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details.
# Example: mongodb+srv://dbuser:mypassword@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority

# Name of the MongoDB database collection for the store
DATABASE_NAME=custom_printing_store

# ------------------------------------------------------------------------------
# 2. Google OAuth 2.0 Credentials (Free Google Cloud Console)
# ------------------------------------------------------------------------------
# Obtained from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Format: <project-id>-<random-hash>.apps.googleusercontent.com
# Used by the backend to cryptographically verify Google ID Tokens
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Exposed to the browser so Google Identity Services button can initialize
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. Server Session Secret (JWT Encryption)
# ------------------------------------------------------------------------------
# Secret key used to cryptographically sign HttpOnly session cookies.
# Generate a secure 32+ character random string in your terminal using:
#   openssl rand -base64 32
SESSION_SECRET=generate_a_secure_random_32_character_string_here

# ------------------------------------------------------------------------------
# 4. Nodemailer / Gmail Configuration (Optional - for Lead Inquiries)
# ------------------------------------------------------------------------------
# Your Gmail address used to dispatch customer inquiry emails
GMAIL_EMAIL=your_email@gmail.com

# 16-character App Password generated in Google Account > Security > App Passwords
GMAIL_APP_PASSWORD=your_16_character_app_password
